---
import { Image } from "astro:assets"

import emblem from "@/assets/logo/emblem.png"

interface Props {
  size?: number
  class?: string
}

const { size = 24, class: className } = Astro.props
---

<Image
  width={Math.round(size * (473 / 512))}
  height={size}
  src={emblem}
  loading="eager"
  alt="Arkhins - Emblem"
  class:list={["invert dark:invert-0", className]}
/>
