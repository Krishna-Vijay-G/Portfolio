---
import { SendIcon } from "@lucide/astro"

import { contactForm } from "@/data/site"

const { endpoint, fields } = contactForm
---

<form method="POST" action={endpoint} target="contact-sink" data-form class="flex flex-col gap-6">
  <label class="flex flex-col gap-1.5">
    <span class="text-sm italic">name</span>
    <input
      required
      type="text"
      name={fields.name}
      autocomplete="name"
      class="border-b bg-transparent py-2 text-base transition-colors outline-none focus:border-foreground"
    />
  </label>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm italic">email</span>
    <input
      required
      type="email"
      name={fields.email}
      autocomplete="email"
      class="border-b bg-transparent py-2 text-base transition-colors outline-none focus:border-foreground"
    />
  </label>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm italic">subject</span>
    <input
      required
      type="text"
      name={fields.subject}
      class="border-b bg-transparent py-2 text-base transition-colors outline-none focus:border-foreground"
    />
  </label>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm italic">message</span>
    <textarea
      required
      rows="4"
      name={fields.message}
      class="resize-y border-b bg-transparent py-2 text-base transition-colors outline-none focus:border-foreground"
    ></textarea>
  </label>

  <button type="submit" class="mt-4 self-start px-4">
    send
    <SendIcon size="14" stroke-width="1.5" />
  </button>
</form>

<iframe name="contact-sink" title="form target" hidden data-sink></iframe>

<script>
  const initializeContactForm = () => {
    const form = document.querySelector<HTMLFormElement>("[data-form]")
    const sink = document.querySelector<HTMLIFrameElement>("[data-sink]")
    const wrapper = document.querySelector("[data-contact-form]")
    const success = document.querySelector("[data-contact-success]")
    if (!form || !sink) return

    let submitted = false

    form.onsubmit = () => {
      submitted = true
    }

    sink.onload = () => {
      if (!submitted) return
      wrapper?.classList.add("hidden")
      success?.classList.remove("hidden")
    }
  }

  document.addEventListener("astro:page-load", initializeContactForm)
  initializeContactForm()
</script>
